<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title></title>
    <dateModified></dateModified>
    <ownerName></ownerName>
  </head>
  <body>
<outline text="inet_init">
</outline>
<outline text="fs_initcall(inet_init)">
  <outline text="proto_register(&amp;amp;tcp_prot, 1);">
  </outline>
  <outline text="proto_register(&amp;amp;udp_prot, 1)">
  </outline>
  <outline text="proto_register(&amp;amp;raw_prot, 1)">
  </outline>
  <outline text="proto_register(&amp;amp;ping_prot, 1)">
  </outline>
  <outline text="sock_register(&amp;amp;inet_family_ops)">
  </outline>
  <outline text="ip_static_sysctl_init();">
    <outline text="register_net_sysctl(&amp;amp;init_net, &quot;net/ipv4/route&quot;, ipv4_route_table)">
    </outline>
  </outline>
  <outline text="inet_add_protocol(&amp;amp;icmp_protocol, IPPROTO_ICMP)">
  </outline>
  <outline text="inet_add_protocol(&amp;amp;udp_protocol, IPPROTO_UDP)">
  </outline>
  <outline text="inet_add_protocol(&amp;amp;tcp_protocol, IPPROTO_TCP)">
  </outline>
  <outline text="inet_add_protocol(&amp;amp;igmp_protocol, IPPROTO_IGMP)">
  </outline>
  <outline text="for (r = &amp;amp;inetsw[0]; r &amp;lt; &amp;amp;inetsw[SOCK_MAX]; ++r)" _note="        INIT_LIST_HEAD(r);">
  </outline>
  <outline text="for (q = inetsw_array; q &amp;lt; &amp;amp;inetsw_array[INETSW_ARRAY_LEN]; ++q)" _note="        inet_register_protosw(q)">
  </outline>
  <outline text="arp_init()">
    <outline text="dev_add_pack(&amp;amp;arp_packet_type)">
    </outline>
    <outline text="neigh_sysctl_register(NULL, &amp;amp;arp_tbl.parms, NULL)">
    </outline>
    <outline text="register_netdevice_notifier(&amp;amp;arp_netdev_notifier)">
    </outline>
  </outline>
  <outline text="ip_init()">
    <outline text="ip_rt_init">
    </outline>
  </outline>
  <outline text="tcp_init()">
  </outline>
  <outline text="udp_init()">
  </outline>
  <outline text="udplite4_register()">
    <outline text="proto_register(&amp;amp;udplite_prot, 1)">
    </outline>
    <outline text="inet_add_protocol(&amp;amp;udplite_protocol, IPPROTO_UDPLITE)">
    </outline>
    <outline text="inet_register_protosw(&amp;amp;udplite4_protosw)">
    </outline>
    <outline text="udplite4_proc_init()">
    </outline>
  </outline>
  <outline text="ping_init()">
  </outline>
  <outline text="icmp_init()">
  </outline>
  <outline text="ip_mr_init()">
  </outline>
  <outline text="init_inet_pernet_ops()">
  </outline>
  <outline text="init_ipv4_mibs()">
  </outline>
  <outline text="ipv4_proc_init()">
  </outline>
  <outline text="ipfrag_init()">
  </outline>
  <outline text="dev_add_pack(&amp;amp;ip_packet_type)">
    <outline text="static struct packet_type ip_packet_type __read_mostly = {" _note="    .type = cpu_to_be16(ETH_P_IP),&#10;    .func = ip_rcv,&#10;    .list_func = ip_list_rcv,&#10;&#10;};">
    </outline>
  </outline>
  <outline text="ip_tunnel_core_init()">
  </outline>
</outline>
  </body>
</opml>
